{
  "name": "ble-scan",
  "version": "0.1.0",
  "description": "A spec-driven TypeScript package.",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "next dev",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@scope/widgets": "^2.0.0",
    "from_git": "git+https://git.example/from_git.git#v1.4.0",
    "linked_tool": "link:../linked_tool",
    "local_sibling": "file:../local_sibling",
    "next": "^16.3.0",
    "shared": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
