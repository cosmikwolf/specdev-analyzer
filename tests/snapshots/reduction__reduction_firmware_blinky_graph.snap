entities:
- kind: module
  extends: structural
  name: AudioPipeline
  attrs:
    description: Routes PCM frames from BtA2dpSink to I2sOutput, surfaces state via StatusLed, and reports underruns.
    layer: middleware
  provenance:
    source_file: specs/modules/AudioPipeline.toml
    pointer: ''
- kind: module
  extends: structural
  name: BtA2dpSink
  attrs:
    description: Bluetooth A2DP sink. Accepts an incoming audio stream from a paired source and exposes it via audio_out.
    layer: driver
  provenance:
    source_file: specs/modules/BtA2dpSink.toml
    pointer: ''
- kind: module
  extends: structural
