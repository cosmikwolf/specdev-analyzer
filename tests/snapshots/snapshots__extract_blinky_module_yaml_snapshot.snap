---
source: tests/snapshots.rs
expression: yaml
---
actions:
- blocking: false
  description: Construct a StatusLed bound to the given GPIO pins.
  isr_safe: false
  name: new
  params:
  - direction: in
    name: data_pin
    type: GpioPin
  - direction: in
    name: clock_pin
    type: GpioPin
  returns: Result<StatusLed, LedError>
- blocking: false
  description: Display a solid RGB color.
  isr_safe: false
  name: set_solid
  params:
  - direction: in
    name: r
    type: u8
  - direction: in
    name: g
    type: u8
  - direction: in
    name: b
    type: u8
  returns: Result<(), LedError>
- blocking: false
  description: Display a named blink pattern.
  isr_safe: false
  name: set_pattern
  params:
  - direction: in
    name: pattern
    type: StatusPattern
  returns: Result<(), LedError>
- blocking: false
  description: Turn the LED off.
  isr_safe: false
  name: off
  params: []
  returns: Result<(), LedError>
depends_on: []
description: APA102 DotStar LED driver providing solid / blinking status patterns.
errors:
- description: Underlying GPIO write failed.
  variant: GpioError
- description: Requested pattern is not defined for this LED.
  variant: InvalidPattern
hardware:
  pins:
  - name: DATA
    pin: 2
    port: GPIO
    role: dotstar_data
  - name: CLK
    pin: 12
    port: GPIO
    role: dotstar_clock
layer: driver
metadata:
  ConcurrencyModel:
    isr_safe: false
    protection: mutex
    reentrant: false
    shared_state: []
  ErrorHandling:
    error_type: LedError
    strategy: result_type
  MemoryModel:
    allocation: static_alloc
    max_instances: 1
    owner: owned
  Ownership:
    owner: owned
name: StatusLed
ports:
- direction: in
  flow_type: StatusPattern
  name: led_in
  port_type: LedCommandPort
satisfies: []
state_machines:
- initial: off
  name: LedFSM
  states:
  - off
  - solid
  - blinking
  transitions:
  - event: set_solid_evt
    from: off
    name: off_to_solid
    to: solid
  - event: set_pattern_evt
    from: off
    name: off_to_blinking
    to: blinking
  - event: turn_off_evt
    from: solid
    name: solid_to_off
    to: off
  - event: set_pattern_evt
    from: solid
    name: solid_to_blinking
    to: blinking
  - event: turn_off_evt
    from: blinking
    name: blinking_to_off
    to: off
  - event: set_solid_evt
    from: blinking
    name: blinking_to_solid
    to: solid
