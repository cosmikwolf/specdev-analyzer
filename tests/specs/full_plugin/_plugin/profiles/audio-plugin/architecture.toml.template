# Architecture facts for an audio-plugin project.
#
# Dependencies, features and the crate version live in Cargo.toml, which
# is the truth for them; this file holds the plugin's identity, its audio
# layout and its panic strategy.

# ---------------------------------------------------------------------------
# Plugin identity — shown in host plugin browsers.
# ---------------------------------------------------------------------------
[plugin]
name     = "{{project_name}}"
vendor   = "ExampleCo"
category = "instrument"     # instrument | fx | midi-fx | analyzer
formats  = ["vst3", "clap", "standalone"]

# ---------------------------------------------------------------------------
# Audio layout.
# ---------------------------------------------------------------------------
[audio]
default_channel_layout = "stereo"   # mono | stereo | quad | five-one | seven-one

# ---------------------------------------------------------------------------
# Runtime: the panic strategy the plugin is built with.
# ---------------------------------------------------------------------------
[runtime]
panic_handler  = "abort"
