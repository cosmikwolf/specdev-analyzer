# Architecture-level decisions for an audio-plugin project.
#
# Three required tables: [plugin] (vendor + format identity), [audio]
# (bus layout + sample-rate bounds), [runtime] (panic strategy).
# Optional [[features]] declares Cargo features. Codegen emits
# Cargo.toml from these fields plus per-module external_deps[].

# ---------------------------------------------------------------------------
# Plugin identity — vendor / display / formats. All five required fields
# surface in plugin metadata panels.
# ---------------------------------------------------------------------------
[plugin]
name     = "{{project_name}}"
vendor   = "ExampleCo"
version  = "0.1.0"          # strict three-part numeric SemVer; no -rc suffixes
category = "instrument"     # instrument | fx | midi-fx | analyzer
formats  = ["vst3", "clap", "standalone"]
# url    = "https://example.com/{{project_name}}"
# email  = "support@example.com"

# ---------------------------------------------------------------------------
# Audio bus configuration. `default_channel_layout` is required; aux
# buses are optional sidechains / sends.
# ---------------------------------------------------------------------------
[audio]
default_channel_layout = "stereo"   # mono | stereo | quad | five-one | seven-one
# min_sample_rate      = 22050
# max_sample_rate      = 192000
# latency_samples      = 0          # set when DSP path introduces fixed delay

# Optional sidechain inputs:
# [[audio.aux_inputs]]
# name          = "sidechain"
# channel_count = 2

# Optional auxiliary outputs:
# [[audio.aux_outputs]]
# name          = "send"
# channel_count = 2

# ---------------------------------------------------------------------------
# Runtime — panic strategy. VST3 cdylib MUST use `abort` (Rust unwinding
# through a C ABI is undefined behavior). Standalone-only builds may
# choose `unwind`.
# ---------------------------------------------------------------------------
[runtime]
panic_handler  = "abort"
realtime_audit = false      # informational today; no graph check reads it

# ---------------------------------------------------------------------------
# Cargo features (optional). Mirrors library-api's [[features]] shape.
# Modules reference these via `feature_gates = [...]`.
# ---------------------------------------------------------------------------

# EXAMPLE: optional MIDI handling.
# [[features]]
# name = "midi"
# description = "Enable MIDI input/output handling."

# EXAMPLE: a SIMD-optimized DSP backend.
# [[features]]
# name = "simd"
# description = "Use packed SIMD for the DSP hot path."
# cargo_deps  = ["dep:wide"]

# ---------------------------------------------------------------------------
# Open list for crate dependencies that don't fit a typed slot above.
# Every entry lands in Cargo.toml [dependencies].
# ---------------------------------------------------------------------------

# EXAMPLE: lock-free ring buffer for cross-thread state publication
# (a vanilla crates.io dep — `source` omitted defaults to crates.io).
# [[external_deps]]
# crate = "rtrb"
# version = "^0.4"

# EXAMPLE: depend on a sibling workspace member by path. `source` is a
# tagged union; the path form is `{ path = "..." }` (NOT
# `source = "path", path = "..."`). Other forms accepted by the schema:
#   source = "workspace"                       — `<dep>.workspace = true` inheritance
#   source = { git = "https://...", rev = "..." } — git-dep with rev/tag/branch
#   source = "crates-io"                       — explicit default (same as omitting `source`)
# [[external_deps]]
# crate    = "ym2414b-core"
# version  = "0.1"
# source   = { path = "../ym2414b-core" }
# features = ["std"]

# EXAMPLE: inherit from the workspace's [workspace.dependencies] table.
# Use this when the workspace shell hoists the dep and members opt in
# per-member. Permitted alongside `optional = true`.
# [[external_deps]]
# crate  = "serde"
# version = "1"
# source  = "workspace"
