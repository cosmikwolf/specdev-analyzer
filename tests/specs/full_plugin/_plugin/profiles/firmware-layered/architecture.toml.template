# Architecture facts for a firmware-layered project.
#
# Dependencies, features and build profiles live in Cargo.toml, which is
# the truth for them; this file holds what Cargo.toml does not.

# ---------------------------------------------------------------------------
# Platform — the build target. The gate script reads `target_triple`
# (`cargo check --target ${root.platform.target_triple}`).
# ---------------------------------------------------------------------------
[platform]
# Rust target triple. Examples:
#   thumbv8m.main-none-eabihf  (Cortex-M33 with FPU; STM32H5, NXP RT600)
#   thumbv7em-none-eabihf      (Cortex-M4F / M7F; STM32F4, STM32H7)
#   thumbv7em-none-eabi        (Cortex-M4 / M7 no-FPU)
#   thumbv6m-none-eabi         (Cortex-M0 / M0+)
target_triple = "thumbv8m.main-none-eabihf"

# ---------------------------------------------------------------------------
# Cross-module port connections (optional). `connection_endpoints_resolve`
# checks that each end names a `Module.port` that exists.
# ---------------------------------------------------------------------------
# [[connections]]
# from = "Sensor.reading"
# to = "Display.input"
# flow_type = "Measurement"

# ---------------------------------------------------------------------------
# Decisions that shape the whole project (optional).
# ---------------------------------------------------------------------------
# project_decisions = ["DEC-001"]
