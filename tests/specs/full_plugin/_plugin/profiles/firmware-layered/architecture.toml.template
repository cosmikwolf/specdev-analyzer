# Architecture-level decisions for a firmware-layered project.
#
# Phase 6.7+: this file captures project-wide infrastructure picks
# (platform, runtime, logger) AS WELL AS cross-module port
# connections. Every Cargo dep is captured here or in modules; Phase
# 8's `gen` emits Cargo.toml from these fields. The spec is the source
# of truth.

# ---------------------------------------------------------------------------
# Platform — hardware target + ARM core support crates.
# ---------------------------------------------------------------------------
[platform]
# Rust target triple. Examples:
#   thumbv8m.main-none-eabihf  (Cortex-M33 with FPU; STM32H5, NXP RT600)
#   thumbv7em-none-eabihf      (Cortex-M4F / M7F; STM32F4, STM32H7)
#   thumbv7em-none-eabi        (Cortex-M4 / M7 no-FPU)
#   thumbv6m-none-eabi         (Cortex-M0 / M0+)
target_triple = "thumbv8m.main-none-eabihf"

# Specific MCU part. Drives the inlined MCU block's HAL feature flag at
# codegen time. Set to your concrete part identifier (lowercase, no
# punctuation), e.g. "stm32h563", "stm32f411", "stm32h743".
# mcu_part = "stm32h563"

[platform.mcu_core]
crate = "cortex-m"
version = "^0.7"

[platform.mcu_runtime]
crate = "cortex-m-rt"
version = "^0.7"

# ---------------------------------------------------------------------------
# Runtime — panic handler, optional allocator + critical-section impl.
# ---------------------------------------------------------------------------
[runtime.panic_handler]
crate = "panic-probe"
version = "^0.3"
features = ["print-defmt"]

# Optional: enable an allocator only when modules need `alloc`.
# [runtime.allocator]
# crate = "embedded-alloc"
# version = "^0.5"

# Optional: most cortex-m projects rely on the impl bundled with
# `cortex-m`; supply this only when overriding.
# [runtime.critical_section_impl]
# crate = "critical-section"
# version = "^1.1"

# ---------------------------------------------------------------------------
# Logger — defmt is the de-facto standard for embedded Rust.
# ---------------------------------------------------------------------------
[logger.provider]
crate = "defmt"
version = "^0.3"

[logger.backend]
crate = "defmt-rtt"
version = "^0.4"

# default_level: trace | debug | info | warn | error | off
# logger.default_level = "info"

# ---------------------------------------------------------------------------
# Open list for project-author crate additions beyond the typed slots
# above. Every entry lands in Cargo.toml [dependencies].
# ---------------------------------------------------------------------------
# [[external_deps]]
# crate = "heapless"
# version = "^0.8"
# features = ["serde"]

# [[external_deps]]
# crate = "static-cell"
# version = "^2"

# ---------------------------------------------------------------------------
# Cross-module port connections.
#
# Each [[connections]] entry wires one module's port to another module's
# port. Both endpoints use the form `Module.port`; the analyzer's
# `connection_endpoints_resolve` graph check verifies that both names
# exist in the project's module set.
#
# `flow_type` is optional and free-form; it documents what kind of data
# flows across the connection (e.g. `audio_frame`, `midi_event`).
# ---------------------------------------------------------------------------

# EXAMPLE: an audio source feeds an audio sink.
# [[connections]]
# from = "AudioSource.out"
# to = "AudioSink.in"
# flow_type = "audio_frame"

# EXAMPLE: a sensor exposes events to a controller.
# [[connections]]
# from = "RotaryEncoder.event_out"
# to = "MainController.encoder_event_in"
# flow_type = "encoder_event"
