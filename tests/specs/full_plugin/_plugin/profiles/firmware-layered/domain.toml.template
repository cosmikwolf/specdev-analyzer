# firmware-layered project graph checks.
#
# Each [[project.graph_checks]] runs after validate parses module +
# architecture + requirements TOMLs and the reduction materializes the
# universal (entities, relations) graph. The `scope` field pre-filters
# the graph view to entries of a given kind via the extends chain
# (e.g. scope = "Module" passes only Module-extending entities through
# to the check). Unscoped checks see the full graph.
#
# Severity per rule is configured in [validation.rules].

[domain]
name = "{{project_name}}"

[validation]
[validation.rules]
unique_qualified_names                       = "error"
modules_acyclic                              = "error"
layer_dependency                             = "error"
connection_endpoints_resolve                 = "error"
feature_unique_names                         = "error"
requirement_ids_unique                       = "error"
requirements_have_satisfiers                 = "warning"
# Triad consistency checks (the *how & why* + *known unknowns*).
decision_supersedes_acyclic                  = "error"
decision_supersedes_chain_consistency        = "error"
open_question_closed_by_resolves             = "error"
open_question_status_consistency             = "error"
codegen_unblocked                            = "warning"

# Convention: typed-relation ref resolution (decided_by, guided_by,
# project_decisions, supersedes, closes_questions, defaults_for,
# affects, default_via, satisfies, depends_on, feature_gates,
# feature.depends_on) is enforced by REDUCE_UNRESOLVED at reduce time
# — when a target name doesn't resolve, reduction drops the edge and
# emits REDUCE_UNRESOLVED naming the source entity + the unknown
# target. graph_check is reserved for non-ref-resolution invariants:
# uniqueness, acyclicity, attr-shaped reference resolution (e.g.
# closed_by, connection.from/to), status-cross-reference consistency,
# codegen gating.

# Module names must be unique across the project.
[[project.graph_checks]]
kind = "unique"
rule = "unique_qualified_names"
scope = "Module"
field = "entities[].name"

# Module dependency graph must be acyclic. The `depends_on` scope filters
# relations to module-to-module edges; same-array-index pairing yields
# (from, to) tuples for the cycle check.
[[project.graph_checks]]
kind = "acyclic"
rule = "modules_acyclic"
entity_scope = "Module"
relation_scope = "depends_on"
edges_from = "relations[].from"
edges_to = "relations[].to"

# Layered architecture: application → middleware → driver → HAL → PAC.
# Same-layer dependencies are allowed; upward dependencies (e.g. HAL → application)
# violate the ordering and are flagged. The graph-shape `layer_dependency`
# primitive jointly filters entities (by `entity_scope`) and relations
# (by `relation_scope`), then checks each `(from, to)` edge against the
# ordering top-down.
[[project.graph_checks]]
kind = "layer_dependency"
rule = "layer_dependency"
entity_scope = "Module"
relation_scope = "depends_on"
layer_field = "attrs.layer"
layer_ordering = ["application", "middleware", "driver", "HAL", "PAC"]

# Connection endpoints (`Module.port`) must name an existing qualified
# port. Both the `from` and `to` sides are checked.
#
# These checks are unscoped (no `scope =` field). Reasoning: the source
# field `entities[].attrs.from` only matches Connection entities (only
# Connections have an `attrs.from` field, so the path-selector picks
# naturally filter to Connections without needing kind-scope). The
# target field `entities[].name` matches across all entity kinds —
# correct here because Port qualified names (`Module.port`) are
# structurally distinct from Module names (no `.`) and Connection
# synthetic names (containing `->`), so a Connection.attrs.from value
# only resolves against actual Port entries.
#
# If a real project surfaces a name-collision case (e.g. a Module named
# `Foo.bar`), this check needs the two-scope form (separate
# source_scope and target_scope), which is a future graph-check
# primitive extension.
[[project.graph_checks]]
kind = "reference_exists"
rule = "connection_endpoints_resolve"
source_field = "entities[].attrs.from"
target_field = "entities[].name"

[[project.graph_checks]]
kind = "reference_exists"
rule = "connection_endpoints_resolve"
source_field = "entities[].attrs.to"
target_field = "entities[].name"

# Cargo feature names must be unique.
[[project.graph_checks]]
kind = "unique"
rule = "feature_unique_names"
scope = "Feature"
field = "entities[].name"

# Requirement ids must be unique.
[[project.graph_checks]]
kind = "unique"
rule = "requirement_ids_unique"
scope = "Requirement"
field = "entities[].name"

# Every Requirement with `nature = "module"` (the default) must be
# satisfied by at least one module — orphan requirements warn (F-006).
# Set `nature = "architecture" | "build" | "test"` on a requirement to
# exempt it from this check.
[[project.graph_checks]]
kind = "requirements_have_satisfiers"
rule = "requirements_have_satisfiers"
entity_scope = "Requirement"
relation_scope = "module_satisfies"

# ---------------------------------------------------------------------------
# Triad consistency.
#
# Per the convention header: typed-relation ref resolution is enforced
# by REDUCE_UNRESOLVED at reduce time. The graph_checks below cover
# what reduction can't: supersession-chain shape (acyclic + orphan-free
# + unique-successor), attr-shaped closed_by resolution, OQ status
# invariants against target Decision status, and the codegen gating
# warning (the gen-side gate is a hard refusal in `specdev-analyzer
# gen`).
# ---------------------------------------------------------------------------

# Supersession chain must be acyclic.
[[project.graph_checks]]
kind = "acyclic"
rule = "decision_supersedes_acyclic"
scope = "decision_supersedes_decision"
edges_from = "relations[].from"
edges_to = "relations[].to"

# Each superseded Decision must be claimed by exactly one inbound
# `decision_supersedes_decision` edge (catches orphan-superseded and
# multi-successor authoring mistakes).
[[project.graph_checks]]
kind = "entity_attr_inbound_count"
rule = "decision_supersedes_chain_consistency"
entity_scope = "Decision"
entity_attr = "status"
entity_attr_value = "superseded"
relation_scope = "decision_supersedes_decision"
expected_count = 1

# OpenQuestion.closed_by is a singular attr (not a relation) — verify it
# resolves to an existing decision name. The whole-graph view filters
# naturally because `entities[].attrs.closed_by` is only populated on
# OpenQuestion entities.
[[project.graph_checks]]
kind = "reference_exists"
rule = "open_question_closed_by_resolves"
source_field = "entities[].attrs.closed_by"
target_field = "entities[].name"

# OQ.status = closed implies closed_by points at an *accepted* Decision.
[[project.graph_checks]]
kind = "entity_attr_target_attr_equals"
rule = "open_question_status_consistency"
entity_scope = "OpenQuestion"
entity_attr = "status"
entity_attr_value = "closed"
target_attr_field = "closed_by"
target_entity_kind = "Decision"
target_attr = "status"
target_attr_value = "accepted"

# OQ.status = default_committed implies default_via points at an
# *accepted* Decision.
[[project.graph_checks]]
kind = "entity_attr_target_attr_equals"
rule = "open_question_status_consistency"
entity_scope = "OpenQuestion"
entity_attr = "status"
entity_attr_value = "default_committed"
target_attr_field = "default_via"
target_entity_kind = "Decision"
target_attr = "status"
target_attr_value = "accepted"

# Codegen-gate informational warning: any Module reachable through an
# `open` OpenQuestion (via Module.satisfies → Requirement →
# OpenQuestion.affects^-1) is gated. validate informs; `gen` hard-refuses.
[[project.graph_checks]]
kind = "module_reachable_through_open_question"
rule = "codegen_unblocked"
