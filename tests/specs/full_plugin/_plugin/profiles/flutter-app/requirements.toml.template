# Flutter app requirements.
#
# Two top-level arrays:
#   [[source]]      — external documents the requirements derive from
#                     (design specs, user stories, platform guidelines, ...).
#   [[requirement]] — the requirements themselves.
#
# Modules reference requirements via their top-level `satisfies = [...]`
# array. The analyzer's `module_satisfies_resolves` and
# `requirement_satisfies_resolves` graph checks verify every reference
# resolves.
#
# App-specific concerns (accessibility targets, store policy
# constraints, offline behavior) are expressed as free-form `text` in
# v1. If multiple app projects find themselves expressing these concerns
# the same way, a future profile evolution can promote them to typed
# fields.
#
# Requirement ids follow `REQ-AREA-NUMBER` (e.g. REQ-UI-001, REQ-BLE-007).
#
# Delete the EXAMPLE entries below once the project has real requirements.

# EXAMPLE: declare an external source document.
# [[source]]
# id = "material-design-3"
# kind = "protocol"
# title = "Material Design 3 Guidelines"
# url = "https://m3.material.io/"

# EXAMPLE: a platform-coverage requirement.
# [[requirement]]
# id = "REQ-PLAT-001"
# text = "The app shall run on Android, iOS, and web from a single codebase."
# nature = "architecture"

# EXAMPLE: a UI requirement derived from the source above.
# [[requirement]]
# id = "REQ-UI-001"
# text = "Screens shall follow Material 3 layout and theming."
# source = ["material-design-3"]

# EXAMPLE: a test requirement — verified by a test item, not satisfied
# by a module (see `nature` in the schema).
# [[requirement]]
# id = "REQ-TEST-001"
# text = "The settings screen shall be covered by a widget test."
# nature = "test"
