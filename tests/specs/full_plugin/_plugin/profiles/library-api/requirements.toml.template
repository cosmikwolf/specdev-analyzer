# Library API requirements.
#
# Two top-level arrays:
#   [[source]]      — external documents the requirements derive from
#                     (Rust API guidelines, RFCs, user research, ...).
#   [[requirement]] — the requirements themselves.
#
# Modules reference requirements via their top-level `satisfies = [...]`
# array. The analyzer's `module_satisfies_resolves` and
# `requirement_satisfies_resolves` graph checks verify every reference
# resolves.
#
# Library-specific concerns (MSRV, no_std/alloc compatibility, semver
# guarantees) are expressed as free-form `text` in v1. If multiple
# library projects find themselves expressing these concerns the same
# way, a future profile evolution can promote them to typed fields.
#
# Requirement ids follow `REQ-AREA-NUMBER` (e.g. REQ-API-001, REQ-NOSTD-007).
#
# Delete the EXAMPLE entries below once the project has real requirements.

# EXAMPLE: declare an external source document.
# [[source]]
# id = "rust-api-guidelines"
# kind = "protocol"
# title = "Rust API Guidelines"
# url = "https://rust-lang.github.io/api-guidelines/"

# EXAMPLE: an MSRV requirement.
# [[requirement]]
# id = "REQ-MSRV-001"
# text = "The library shall compile on MSRV 1.75 with default features."

# EXAMPLE: a no_std compatibility requirement.
# [[requirement]]
# id = "REQ-NOSTD-001"
# text = "The library shall compile with --no-default-features and `alloc` disabled."

# EXAMPLE: an API-stability requirement derived from the source above.
# [[requirement]]
# id = "REQ-API-001"
# text = "Public types shall implement Debug, Clone where applicable."
# source = ["rust-api-guidelines"]
# source_ref = "C-DEBUG, C-COMMON-TRAITS"
