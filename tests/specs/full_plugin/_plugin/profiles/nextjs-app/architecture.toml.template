# Architecture-level decisions for a nextjs-app project.
#
# This file declares the app version, the Node and package-manager pins,
# package.json script overrides, and project-wide npm dependencies.
# Module-level external_deps live in each specs/modules/*.toml; the
# union (plus block/bridge contributions) determines the app's full dep
# set, emitted to package.json by `specdev-analyzer manifest --write`
# (which /spec-gen runs as its manifest step). package.json is OUTPUT,
# never hand-maintained; pnpm-lock.yaml is the package manager's.

# ---------------------------------------------------------------------------
# App version (optional). Emitted as package.json's `version`.
# ---------------------------------------------------------------------------
# version = "0.1.0"

# ---------------------------------------------------------------------------
# Runtime pins (optional). Override the profile's defaults key-by-key
# (`engines.node` ">=22.18.0", `packageManager` "pnpm@10.15.0").
# ---------------------------------------------------------------------------
# [environment]
# node = ">=22.18.0"
# package_manager = "pnpm@10.15.0"

# ---------------------------------------------------------------------------
# package.json scripts (optional). Override the profile defaults
# (dev / build / start / typegen / check / test / e2e) key-by-key.
# ---------------------------------------------------------------------------
# [scripts]
# lint = "eslint ."

# ---------------------------------------------------------------------------
# Project-wide npm dependencies — infrastructure packages every module
# may assume. Module-scoped packages belong in each module's
# `external_deps` instead.
#
# Accepted shapes (exactly one source key; registry deps need `version`):
#   { package = "zod", version = "^4.0.0" }                       — npm registry
#   { package = "x", git = { url = "git+https://…/x.git", ref = "v1.4.0" } }
#   { package = "local_pkg", path = "../local_pkg" }               — file:
#   { package = "linked_tool", link = "../linked_tool" }           — link:
#   { package = "shared", workspace = "*" }                        — workspace:*
# `test_only = true` routes an entry to devDependencies.
#
# The framework, React, the two client/server guard packages, the type
# checker, the test runners and the formatter are seeded here — every
# nextjs-app project needs them, and the profile's gates
# (`next typegen` → `tsc --noEmit` → `vitest run`; `next build`) and the
# /spec-gen formatter step resolve against them. Pins are the registry
# state of 2026-09-09 (pins come from the registry, not from memory);
# `@types/node` tracks the Node major in `engines`.
# ---------------------------------------------------------------------------
[[external_deps]]
package = "next"
version = "^16.3.0"

[[external_deps]]
package = "react"
version = "^19.2.0"

[[external_deps]]
package = "react-dom"
version = "^19.2.0"

[[external_deps]]
package = "server-only"
version = "^0.0.1"

[[external_deps]]
package = "client-only"
version = "^0.0.1"

[[external_deps]]
package = "typescript"
version = "^7.0.0"
test_only = true

[[external_deps]]
package = "@types/node"
version = "^22.0.0"
test_only = true

[[external_deps]]
package = "@types/react"
version = "^19.2.0"
test_only = true

[[external_deps]]
package = "@types/react-dom"
version = "^19.2.0"
test_only = true

[[external_deps]]
package = "vitest"
version = "^5.0.0"
test_only = true

[[external_deps]]
package = "@vitejs/plugin-react"
version = "^6.1.0"
test_only = true

[[external_deps]]
package = "vite"
version = "^8.2.0"
test_only = true

[[external_deps]]
package = "@playwright/test"
version = "^1.63.0"
test_only = true

[[external_deps]]
package = "prettier"
version = "^3.9.0"
test_only = true

# ---------------------------------------------------------------------------
# Project-shape decisions (optional). Decision ids that shape the
# project as a whole (rendering strategy, data-access layer,
# authentication approach).
# ---------------------------------------------------------------------------
# project_decisions = ["DEC-001"]
