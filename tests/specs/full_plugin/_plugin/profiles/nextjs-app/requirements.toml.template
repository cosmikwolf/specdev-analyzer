# Next.js app requirements.
#
# Two top-level arrays:
#   [[source]]      — external documents the requirements derive from
#                     (design specs, user stories, API contracts, ...).
#   [[requirement]] — the requirements themselves.
#
# Modules reference requirements via their top-level `satisfies = [...]`
# array. The analyzer's `module_satisfies_resolves` and
# `requirement_satisfies_resolves` graph checks verify every reference
# resolves.
#
# App-specific concerns (accessibility targets, SEO and metadata,
# caching and revalidation behaviour) are expressed as free-form `text`
# in v1. If multiple app projects find themselves expressing these
# concerns the same way, a future profile evolution can promote them to
# typed fields.
#
# Requirement ids follow `REQ-AREA-NUMBER` (e.g. REQ-UI-001, REQ-API-007).
#
# Delete the EXAMPLE entries below once the project has real requirements.

# EXAMPLE: declare an external source document.
# [[source]]
# id = "user-stories"
# kind = "user"
# title = "Event management user stories"

# EXAMPLE: an architecture requirement — captured by the route tree and
# rendering strategy, not by one module body.
# [[requirement]]
# id = "REQ-ARCH-001"
# text = "Public event pages shall be statically prerendered and revalidated hourly."
# nature = "architecture"

# EXAMPLE: a UI requirement derived from the source above.
# [[requirement]]
# id = "REQ-UI-001"
# text = "The events list shall show each event's title, date and venue."
# source = ["user-stories"]

# EXAMPLE: a test requirement — verified by a test item, not satisfied
# by a module (see `nature` in the schema).
# [[requirement]]
# id = "REQ-TEST-001"
# text = "The event repository shall be covered by a unit test."
# nature = "test"
