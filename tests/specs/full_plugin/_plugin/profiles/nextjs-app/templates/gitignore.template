# Written once by `specdev-analyzer manifest --write` when absent, then
# externally owned. Everything below is never generated and never
# gen-recorded (see the profile README, "Generated-file ownership").

# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# local databases — a dev or test datasource writes these into the tree.
# `-wal` / `-shm` are SQLite's WAL sidecars and `-journal` its rollback
# journal; which pair appears depends on the journal mode, so ignore all.
*.db
*.db-journal
*.db-wal
*.db-shm

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
