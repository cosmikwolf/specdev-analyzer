# Architecture-level decisions for a rust-app project.
#
# Declares MSRV (optional), the cargo features the crate exposes, and
# application-wide crate dependencies. Crates that only one module needs
# belong in that module's own `external_deps[]` in specs/modules/*.toml;
# the union of both determines the full dep set that `gen` emits to
# Cargo.toml.
#
# NOTE: keys below that are commented out are top-level — if you
# uncomment one, keep it ABOVE the first [[table]] section, or TOML will
# read it as a field of that table.

# ---------------------------------------------------------------------------
# Minimum Supported Rust Version (optional). Cargo-style version
# requirement; emitted as Cargo.toml's `rust-version` field.
# ---------------------------------------------------------------------------
# msrv = "1.75"

# ---------------------------------------------------------------------------
# Application-wide crate dependencies.
#
# Each [[external_deps]] entry lands in Cargo.toml [dependencies]. Use
# this for picks the whole app rests on; keep single-module crates in
# that module's own external_deps[] so the dependency stays traceable.
# ---------------------------------------------------------------------------

# EXAMPLE: an application-wide async runtime.
# [[external_deps]]
# crate = "tokio"
# version = "1"
# features = ["rt-multi-thread", "macros"]

# EXAMPLE: a path dependency on a sibling crate in the same workspace.
# `version` is omitted deliberately — a workspace-internal path dep
# needs no registry version.
# [[external_deps]]
# crate = "my-core"
# source = { path = "../my-core" }

# ---------------------------------------------------------------------------
# Cargo features exposed by the crate.
#
# Each [[features]] entry declares one feature. Modules reference these
# features via their top-level `feature_gates = [...]` array; the
# `module_feature_gates_resolve` graph check verifies every reference
# resolves to a declared feature here.
#
# `depends_on` lists features that must be enabled for this feature to
# be meaningful (cargo's feature dependency syntax).
#
# `default = true` puts the feature in the crate's `[features] default`
# set. At most one feature per cargo project should be `default = true`
# unless you genuinely intend multiple defaults.
#
# Delete the EXAMPLE entries below once the app has its own real
# features; for an app with no optional features at all, leave this
# file empty (just the comment header is fine).

# EXAMPLE: an optional subsystem, off by default.
# [[features]]
# name = "telemetry"
# description = "Emit runtime metrics to the configured collector."

# EXAMPLE: a developer-only affordance kept out of release builds.
# [[features]]
# name = "debug-overlay"
# description = "Render the in-app diagnostics overlay."

# EXAMPLE: a feature that pulls in another feature.
# [[features]]
# name = "serde"
# description = "Serialize/deserialize support via serde."
# depends_on = ["telemetry"]

# ---------------------------------------------------------------------------
# Cargo build profiles ([profile.*]) — for a STANDALONE crate only. In a
# workspace, profiles live in the workspace root's architecture.toml;
# Cargo ignores them in a member manifest and validate rejects them here.
# Closed subset: opt-level, debug, lto, codegen-units, panic, strip,
# overflow-checks, debug-assertions, incremental, plus package.<crate>
# overrides (no panic / lto there).
# ---------------------------------------------------------------------------
# EXAMPLE: a smaller release binary.
# [profiles.release]
# lto = "fat"
# codegen-units = 1
# strip = true
