# rust-workspace project graph checks.
#
# Workspace graph is intentionally minimal — the workspace's only job is
# to enumerate members. Member-level checks (acyclic modules, unique
# requirement ids) run inside each
# member's own validation pass — see the member's `domain.toml`.

[domain]
name = "{{project_name}}"

[validation]
[validation.rules]
unique_member_names                          = "error"
member_paths_unique                          = "error"
decision_ids_unique                          = "error"
# Triad consistency at workspace tier (Module/Requirement-anchored
# checks live in member crates).
decision_supersedes_acyclic                  = "error"
decision_supersedes_chain_consistency        = "error"
open_question_closed_by_resolves             = "error"
open_question_status_consistency             = "error"

# Convention: typed-relation ref resolution (project_decisions,
# supersedes, closes_questions, defaults_for, default_via) is
# enforced by REDUCE_UNRESOLVED at reduce time. graph_check is
# reserved for non-ref-resolution invariants: uniqueness,
# acyclicity, attr-shaped reference resolution (closed_by isn't a
# relation), status-cross-reference consistency.

# Member names must be unique within the workspace.
[[project.graph_checks]]
kind = "unique"
rule = "unique_member_names"
scope = "Member"
field = "entities[].name"

# Member paths must be unique (catches accidental duplicate entries).
[[project.graph_checks]]
kind = "unique"
rule = "member_paths_unique"
scope = "Member"
field = "entities[].attrs.path"

# Decision ids must be unique. Without this check, two `[[decision]]`
# entries with one id both reach the graph and validate exits 0.
[[project.graph_checks]]
kind = "unique"
rule = "decision_ids_unique"
scope = "Decision"
field = "entities[].name"

# ---------------------------------------------------------------------------
# Triad consistency (workspace tier).
#
# Per the convention header: typed-relation ref resolution is enforced
# by REDUCE_UNRESOLVED at reduce time. The graph_checks below cover
# what reduction can't: supersession chain shape, attr-shaped closed_by
# resolution, OQ status invariants. Module-anchored gating lives in
# member crates (workspaces don't host modules directly).
# ---------------------------------------------------------------------------

# Supersession chain must be acyclic.
[[project.graph_checks]]
kind = "acyclic"
rule = "decision_supersedes_acyclic"
scope = "decision_supersedes_decision"
edges_from = "relations[].from"
edges_to = "relations[].to"

# Each superseded Decision must be claimed by exactly one inbound
# `decision_supersedes_decision` edge.
[[project.graph_checks]]
kind = "entity_attr_inbound_count"
rule = "decision_supersedes_chain_consistency"
entity_scope = "Decision"
entity_attr = "status"
entity_attr_value = "superseded"
relation_scope = "decision_supersedes_decision"
expected_count = 1

# OpenQuestion.closed_by must reference an existing decision.
[[project.graph_checks]]
kind = "reference_exists"
rule = "open_question_closed_by_resolves"
source_field = "entities[].attrs.closed_by"
target_field = "entities[].name"

# OQ.status = closed implies closed_by points at an *accepted* Decision.
[[project.graph_checks]]
kind = "entity_attr_target_attr_equals"
rule = "open_question_status_consistency"
entity_scope = "OpenQuestion"
entity_attr = "status"
entity_attr_value = "closed"
target_attr_field = "closed_by"
target_entity_kind = "Decision"
target_attr = "status"
target_attr_value = "accepted"

# OQ.status = default_committed implies default_via points at an
# *accepted* Decision.
[[project.graph_checks]]
kind = "entity_attr_target_attr_equals"
rule = "open_question_status_consistency"
entity_scope = "OpenQuestion"
entity_attr = "status"
entity_attr_value = "default_committed"
target_attr_field = "default_via"
target_entity_kind = "Decision"
target_attr = "status"
target_attr_value = "accepted"
