spec_version = "2.0"

[project]
name = "{{project_name}}"
profile = "{{profile}}"
language = "{{language}}"
max_parallel_agents = 1

[paths]
specs = "specs"
source = "."

# Workspace marker: presence signals "this spec.toml describes a Cargo
# workspace root." Members are independent crates with their own
# `specs/specdev/` trees, bootstrapped per-crate (typically with
# `--profile library-api`). Add entries here as members are added.
[workspace]
resolver = "2"

# Optional: the members `cargo` builds at the root when no `-p` /
# `--workspace` flag is given. Member NAMES from [[workspace.members]]
# (the emitter writes their paths). Use it when a member cannot build
# for the host — a board crate — and must be opted into by hand.
#
# default_members = ["my-core", "my-utils"]
#
# Optional: paths Cargo must not treat as members even though they sit
# under this root (a host-only tool, a vendored crate). Emitted verbatim.
#
# exclude = ["tools/my-monitor"]

# Example member entries — replace with real members. Each entry's
# `name` must match the member's [project].name; `path` is relative
# to this spec.toml.
#
# [[workspace.members]]
# name = "my-core"
# path = "crates/my-core"
#
# [[workspace.members]]
# name = "my-utils"
# path = "crates/my-utils"

[[workspace.members]]
name = "placeholder-member"
path = "crates/placeholder-member"
