# Architecture-level decisions for an audio-plugin project.
#
# Phase 15-A spike (D44–D49) committed this profile shape. Three
# required tables: [plugin] (vendor + format identity), [audio] (bus
# layout + sample-rate bounds), [runtime] (panic strategy). Optional
# [[features]] declares Cargo features. Phase 8 emits Cargo.toml from
# these fields plus per-module external_deps[].

# ---------------------------------------------------------------------------
# Plugin identity — vendor / display / formats. All five required fields
# surface in plugin metadata panels.
# ---------------------------------------------------------------------------
[plugin]
name     = "{{project_name}}"
vendor   = "ExampleCo"
version  = "0.1.0"          # strict three-part numeric SemVer; no -rc suffixes
category = "instrument"     # instrument | fx | midi-fx | analyzer
formats  = ["vst3", "clap", "standalone"]
# url    = "https://example.com/{{project_name}}"
# email  = "support@example.com"

# ---------------------------------------------------------------------------
# Audio bus configuration. `default_channel_layout` is required; aux
# buses are optional sidechains / sends.
# ---------------------------------------------------------------------------
[audio]
default_channel_layout = "stereo"   # mono | stereo | quad | five-one | seven-one
# min_sample_rate      = 22050
# max_sample_rate      = 192000
# latency_samples      = 0          # set when DSP path introduces fixed delay

# Optional sidechain inputs:
# [[audio.aux_inputs]]
# name          = "sidechain"
# channel_count = 2

# Optional auxiliary outputs:
# [[audio.aux_outputs]]
# name          = "send"
# channel_count = 2

# ---------------------------------------------------------------------------
# Runtime — panic strategy. VST3 cdylib MUST use `abort` (Rust unwinding
# through a C ABI is undefined behavior). Standalone-only builds may
# choose `unwind`.
# ---------------------------------------------------------------------------
[runtime]
panic_handler  = "abort"
realtime_audit = false      # informational; future graph-check primitive (D48)

# ---------------------------------------------------------------------------
# Cargo features (optional). Mirrors library-api's [[features]] shape.
# Modules reference these via `feature_gates = [...]`.
# ---------------------------------------------------------------------------

# EXAMPLE: optional MIDI handling.
# [[features]]
# name = "midi"
# description = "Enable MIDI input/output handling."

# EXAMPLE: a SIMD-optimized DSP backend.
# [[features]]
# name = "simd"
# description = "Use packed SIMD for the DSP hot path."
# cargo_deps  = ["dep:wide"]

# ---------------------------------------------------------------------------
# Open list for crate dependencies that don't fit a typed slot above.
# Every entry lands in Cargo.toml [dependencies].
# ---------------------------------------------------------------------------

# EXAMPLE: lock-free ring buffer for cross-thread state publication.
# [[external_deps]]
# crate = "rtrb"
# version = "^0.3"
