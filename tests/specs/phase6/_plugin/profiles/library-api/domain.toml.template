# library-api project graph checks.
#
# Each [[project.graph_checks]] runs after validate parses module +
# architecture + requirements TOMLs and the reduction materializes the
# universal (entities, relations) graph. The `scope` field pre-filters
# the graph view to entries of a given kind via the extends chain.
# Severity per rule is configured in [validation.rules].

[domain]
name = "{{project_name}}"

[validation]
[validation.rules]
unique_qualified_names                       = "error"
modules_acyclic                              = "error"
feature_unique_names                         = "error"
feature_dependencies_resolve                 = "error"
module_feature_gates_resolve                 = "error"
requirement_ids_unique                       = "error"
requirement_satisfies_resolves               = "warning"
module_satisfies_resolves                    = "warning"
requirements_have_satisfiers                 = "warning"
# Triad ref-resolution + consistency checks (the *how & why* + *known unknowns*).
requirement_decided_by_resolves              = "error"
module_guided_by_resolves                    = "error"
architecture_project_decisions_resolves      = "error"
decision_supersedes_resolves                 = "error"
decision_supersedes_acyclic                  = "error"
decision_supersedes_chain_consistency        = "error"
decision_closes_questions_resolves           = "error"
decision_defaults_for_resolves               = "error"
open_question_affects_resolves               = "error"
open_question_default_via_resolves           = "error"
open_question_closed_by_resolves             = "error"
open_question_status_consistency             = "error"
codegen_unblocked                            = "warning"

# Module names must be unique across the library.
[[project.graph_checks]]
kind = "unique"
rule = "unique_qualified_names"
scope = "Module"
field = "entities[].name"

# Module dependency graph must be acyclic.
[[project.graph_checks]]
kind = "acyclic"
rule = "modules_acyclic"
scope = "depends_on"
edges_from = "relations[].from"
edges_to = "relations[].to"

# Cargo feature names must be unique.
[[project.graph_checks]]
kind = "unique"
rule = "feature_unique_names"
scope = "Feature"
field = "entities[].name"

# Each feature's depends_on must reference declared features.
[[project.graph_checks]]
kind = "reference_exists"
rule = "feature_dependencies_resolve"
scope = "feature_depends_on"
source_field = "relations[].to"
target_field = "entities[].name"

# Every Module.feature_gates entry must name a declared feature.
[[project.graph_checks]]
kind = "reference_exists"
rule = "module_feature_gates_resolve"
scope = "module_feature_gate"
source_field = "relations[].to"
target_field = "entities[].name"

# Requirement ids must be unique.
[[project.graph_checks]]
kind = "unique"
rule = "requirement_ids_unique"
scope = "Requirement"
field = "entities[].name"

# Requirement.satisfies entries must reference existing requirement ids.
[[project.graph_checks]]
kind = "reference_exists"
rule = "requirement_satisfies_resolves"
scope = "satisfies"
source_field = "relations[].to"
target_field = "entities[].name"

# Module.satisfies entries must reference existing requirement ids.
[[project.graph_checks]]
kind = "reference_exists"
rule = "module_satisfies_resolves"
scope = "module_satisfies"
source_field = "relations[].to"
target_field = "entities[].name"

# Every Requirement with `nature = "module"` (the default) must be
# satisfied by at least one module — orphan requirements warn (F-006).
# Set `nature = "architecture" | "build" | "test"` on a requirement to
# exempt it from this check.
[[project.graph_checks]]
kind = "requirements_have_satisfiers"
rule = "requirements_have_satisfiers"
entity_scope = "Requirement"
relation_scope = "module_satisfies"

# ---------------------------------------------------------------------------
# Triad ref-resolution + consistency.
#
# These checks gate the decisions + open_questions triad: every cross-ref
# must resolve to an existing entity, the supersession graph must be
# acyclic with each superseded decision claimed by exactly one accepted
# successor, and OQ status must agree with the closed_by / default_via
# fields. The last check (`codegen_unblocked`) is a warning that informs
# at validate time; the gen-side gate is a hard refusal in
# `specdev-analyzer gen`.
# ---------------------------------------------------------------------------

# Requirement.decided_by entries must reference an existing decision.
[[project.graph_checks]]
kind = "reference_exists"
rule = "requirement_decided_by_resolves"
scope = "requirement_decided_by_decision"
source_field = "relations[].to"
target_field = "entities[].name"

# Module.guided_by entries must reference an existing decision.
[[project.graph_checks]]
kind = "reference_exists"
rule = "module_guided_by_resolves"
scope = "module_guided_by_decision"
source_field = "relations[].to"
target_field = "entities[].name"

# Architecture.project_decisions entries must reference an existing decision.
[[project.graph_checks]]
kind = "reference_exists"
rule = "architecture_project_decisions_resolves"
scope = "architecture_project_decision"
source_field = "relations[].to"
target_field = "entities[].name"

# Decision.supersedes entries must reference an existing decision.
[[project.graph_checks]]
kind = "reference_exists"
rule = "decision_supersedes_resolves"
scope = "decision_supersedes_decision"
source_field = "relations[].to"
target_field = "entities[].name"

# Supersession chain must be acyclic.
[[project.graph_checks]]
kind = "acyclic"
rule = "decision_supersedes_acyclic"
scope = "decision_supersedes_decision"
edges_from = "relations[].from"
edges_to = "relations[].to"

# Each superseded Decision must be claimed by exactly one inbound
# `decision_supersedes_decision` edge (catches orphan-superseded and
# multi-successor authoring mistakes).
[[project.graph_checks]]
kind = "entity_attr_inbound_count"
rule = "decision_supersedes_chain_consistency"
entity_scope = "Decision"
entity_attr = "status"
entity_attr_value = "superseded"
relation_scope = "decision_supersedes_decision"
expected_count = 1

# Decision.closes_questions entries must reference an existing OQ.
[[project.graph_checks]]
kind = "reference_exists"
rule = "decision_closes_questions_resolves"
scope = "decision_closes_open_question"
source_field = "relations[].to"
target_field = "entities[].name"

# Decision.defaults_for entries must reference an existing OQ.
[[project.graph_checks]]
kind = "reference_exists"
rule = "decision_defaults_for_resolves"
scope = "decision_defaults_open_question"
source_field = "relations[].to"
target_field = "entities[].name"

# OpenQuestion.affects entries must reference an existing requirement.
[[project.graph_checks]]
kind = "reference_exists"
rule = "open_question_affects_resolves"
scope = "open_question_affects_requirement"
source_field = "relations[].to"
target_field = "entities[].name"

# OpenQuestion.default_via must reference an existing decision.
[[project.graph_checks]]
kind = "reference_exists"
rule = "open_question_default_via_resolves"
scope = "open_question_default_via_decision"
source_field = "relations[].to"
target_field = "entities[].name"

# OpenQuestion.closed_by is a singular attr (not a relation) — verify it
# resolves to an existing decision name. The whole-graph view filters
# naturally because `entities[].attrs.closed_by` is only populated on
# OpenQuestion entities.
[[project.graph_checks]]
kind = "reference_exists"
rule = "open_question_closed_by_resolves"
source_field = "entities[].attrs.closed_by"
target_field = "entities[].name"

# OQ.status = closed implies closed_by points at an *accepted* Decision.
[[project.graph_checks]]
kind = "entity_attr_target_attr_equals"
rule = "open_question_status_consistency"
entity_scope = "OpenQuestion"
entity_attr = "status"
entity_attr_value = "closed"
target_attr_field = "closed_by"
target_entity_kind = "Decision"
target_attr = "status"
target_attr_value = "accepted"

# OQ.status = default_committed implies default_via points at an
# *accepted* Decision.
[[project.graph_checks]]
kind = "entity_attr_target_attr_equals"
rule = "open_question_status_consistency"
entity_scope = "OpenQuestion"
entity_attr = "status"
entity_attr_value = "default_committed"
target_attr_field = "default_via"
target_entity_kind = "Decision"
target_attr = "status"
target_attr_value = "accepted"

# Codegen-gate informational warning: any Module reachable through an
# `open` OpenQuestion (via Module.satisfies → Requirement →
# OpenQuestion.affects^-1) is gated. validate informs; `gen` hard-refuses.
[[project.graph_checks]]
kind = "module_reachable_through_open_question"
rule = "codegen_unblocked"
