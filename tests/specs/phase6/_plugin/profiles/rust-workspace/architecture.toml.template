# Architecture-level decisions for a Cargo workspace.
#
# Phase 8.6: this file declares the canonical [workspace.package] fields
# (inherited by member crates via `*.workspace = true` in their
# Cargo.toml) and the hoisted [[workspace_dependencies]] candidates
# (members opt in via `source = "workspace"` on their CrateReference).
#
# Member-specific concerns (modules, requirements, per-crate features,
# per-crate deps) live in the member's own `specs/` tree, NOT here. D36
# enforcement: a workspace spec MUST NOT reference per-member internals.

# ---------------------------------------------------------------------------
# Workspace-level package fields. Each of these is emitted into the
# workspace Cargo.toml's [workspace.package] table; member Cargo.tomls
# inherit any field set here via `<field>.workspace = true`.
#
# `name` and `description` are NOT in this table — `name` is always
# per-crate; `description` is per-crate by Cargo convention. `edition`
# / `rust-version` / `version` / `license` / `repository` are the five
# workspace-inheritable [package] fields per G-005 (zfm dogfood).
# ---------------------------------------------------------------------------
[workspace_package]
version = "0.1.0"
edition = "2021"
# rust-version = "1.75"
# license = "MIT OR Apache-2.0"
# repository = "https://github.com/USER/REPO"

# ---------------------------------------------------------------------------
# Hoisted dependency candidates. Each entry uses the standard
# CrateReference shape (crate, version, source?, features?,
# default_features?). Members opt in per-crate by setting
# `source = "workspace"` on their CrateReference; the member's
# Cargo.toml then emits `<dep> = { workspace = true, ... }`.
#
# Hoist conservatively: only deps that two or more members will share
# at the same version + source belong here. Per-member-only deps stay
# in the member's external_deps[].
# ---------------------------------------------------------------------------

# EXAMPLE: a path-dep on another workspace member.
# [[workspace_dependencies]]
# crate = "my-core"
# version = "0.1.0"
# source = { path = "crates/my-core" }
# default_features = false

# EXAMPLE: a registry crate hoisted across members.
# [[workspace_dependencies]]
# crate = "defmt"
# version = "0.3"
