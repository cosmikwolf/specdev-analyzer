# rust-workspace project graph checks.
#
# Workspace graph is intentionally minimal — the workspace's only job is
# to enumerate members and host the [workspace.package] +
# [[workspace_dependencies]] tables. Member-level checks (acyclic
# modules, unique requirement ids, feature resolution) run inside each
# member's own validation pass — see the member's `domain.toml`.

[domain]
name = "{{project_name}}"

[validation]
[validation.rules]
unique_member_names              = "error"
member_paths_unique              = "error"
workspace_dependencies_unique    = "error"

# Member names must be unique within the workspace.
[[project.graph_checks]]
kind = "unique"
rule = "unique_member_names"
scope = "Member"
field = "entities[].name"

# Member paths must be unique (catches accidental duplicate entries).
[[project.graph_checks]]
kind = "unique"
rule = "member_paths_unique"
scope = "Member"
field = "entities[].attrs.path"

# Workspace-hoisted dep names must be unique.
[[project.graph_checks]]
kind = "unique"
rule = "workspace_dependencies_unique"
scope = "WorkspaceDependency"
field = "entities[].name"
